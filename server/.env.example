# Copy this file to .env and adjust the values.
NODE_ENV=development
PORT=5000

# MongoDB connection string (local, Docker, or MongoDB Atlas)
MONGO_URI=mongodb://127.0.0.1:27017/hotelpro

# Use a long random string in production, e.g. `openssl rand -hex 64`
JWT_SECRET=change-me-to-a-long-random-secret
JWT_EXPIRES_IN=1d

# Comma-separated list of allowed front-end origins (CORS)
CLIENT_URL=http://localhost:5173

# Tax applied to room charges (0.12 = 12%)
TAX_RATE=0.12
CURRENCY=USD
